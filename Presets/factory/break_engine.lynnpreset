 "meta": {
  "category": "Drum & Bass",
  "level": 1,
  "character": "punchy, tight, classic",
  "technique": "ghost snares (velocity must be on: Velocity > Volume) and a fill by tuned toms",
  "secondary": [
   "changing percussion between patterns (hats in A, ride + crash in B)",
   "micro-timed ghost notes by shift",
   "last-hit decay lock on the fill"
  ],
  "voices": "Kick: short, punchy, click. Drum 2/3: two tuned toms. Snare: triangle + noise + sample, driven. Cymbal: ride/crash. Hat: bright metallic.",
  "key": "kick 49 Hz (G1), toms D3 and A#3-ish",
  "bpm": 168,
  "demonstrates": "The backbeat is only a few notes; the break comes from ghost snares at a quarter of the level and a few milliseconds off the grid. B keeps the same drums but swaps the hats for a ride (with a crash made from the same voice by two locks) and extends the tom fill downwards.",
  "patterns": [
   "A: break with ghost snares, hats, tom fill",
   "B: same break, ride + crash instead of hats, longer tom fill"
  ],
  "swing": "53%",
  "length": "16 (tracks of 32)",
  "order": 111
 }
