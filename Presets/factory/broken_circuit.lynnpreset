 "meta": {
  "category": "Electro & Broken",
  "level": 2,
  "character": "tense, off-kilter, dry",
  "technique": "rhythmic displacement: the same kick and bass hits rotated two steps against fixed hats",
  "secondary": [
   "micro-timing by shift (snare early, hat late)",
   "ghost snares with probability",
   "tom-as-bass by per-step note"
  ],
  "voices": "Kick: dry, punchy. Drum 2: tuned clave. Drum 3: tom used as a bass line. Snare: tight crack. Cymbal: short metallic. Hat: tight.",
  "key": "G# (kick 52 Hz, bass voice D2 and neighbours)",
  "bpm": 130,
  "demonstrates": "B contains exactly the same kick and bass triggers as A, moved two steps later; against the unchanged hats and snare the groove leans differently. The snare is pulled slightly early and one hat pushed late, and the ghost snares only play some of the time.",
  "patterns": [
   "A: broken kick / bass / snare groove",
   "B: kick and bass displaced by two steps, bass decays locked"
  ],
  "swing": "50%",
  "length": "16",
