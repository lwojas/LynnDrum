 "meta": {
  "category": "Electro & Broken",
  "level": 1,
  "character": "metallic, bright, precise",
  "technique": "FM percussion: tuned FM voices (metal toms, a bell) with FM depth moved per hit",
  "secondary": [
   "12-step bell figure against 16 (polymeter)",
   "tuned toms answer the bell",
   "bright ride by the cymbal voice"
  ],
  "voices": "Kick: FM sine. Drum 2: FM metal tom. Drum 3: FM bell. Snare: resonant tang. Cymbal: bright ride. Hat: metallic.",
  "key": "C minor-ish (bell C4, G4, C5, D#4 ...)",
  "bpm": 124,
  "demonstrates": "FM Amount is the timbre dial: on the bell it moves a hit from a soft tone to a clanging one, and on the metal tom from wooden to metallic, while the rhythm and pitch of the pattern stay the same.",
  "patterns": [
   "A: groove + bell figure (12 steps)",
   "B: metal-tom answers; FM amount locked per hit"
  ],
  "swing": "52%",
  "length": "16 (tracks of 12)",
