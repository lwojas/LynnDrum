 "meta": {
  "category": "Experimental",
  "level": 2,
  "character": "vast, mechanical, ritual",
  "technique": "polymeter as composition: loop lengths of 11, 9, 7, 13, 29 and 4 steps strike a drone chord; the whole figure repeats after thousands of steps",
  "secondary": [
   "a ratchet from the snare voice's repeat counter, its count locked in B",
   "long dark delay in the FX bus",
   "bell pitch sweep and FM depth locked on the first hits"
  ],
  "voices": "Drum 1: great bell, very long. Drum 2/3: inharmonic FM bells (FX delay). Snare: noise ratchet (repeat counter). Cymbal: gong. Hat: 2 ms clock tick.",
  "key": "C (bells C2, G3, C4)",
  "bpm": 100,
  "demonstrates": "None of the loops share a length, so the strikes fall on different beats every bar. The ratchet is the snare voice retriggering itself (Repeat Count), and the locks make the first hit of each cycle brighter or darker than later ones. Pattern lengths are shown in the pattern editor.",
  "patterns": [
   "A: the mechanism",
   "B: first strikes locked: sweep on the toll, FM depth on the bells, a shorter ratchet"
  ],
  "swing": "50%",
  "length": "16 (tracks of 4, 7, 9, 11, 13, 29)",
  "order": 119
 }
