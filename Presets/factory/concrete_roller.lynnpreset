 "meta": {
  "category": "Techno",
  "level": 2,
  "character": "hypnotic, warm, patient",
  "technique": "polymeter (12 and 10 steps against 16) + a slow tempo-synced LFO on a filter",
  "secondary": [
   "tuned tick figure by per-step note",
   "hat pitch/decay accents by lock"
  ],
  "voices": "Kick: round, a little drive. Drum 2: wooden tuned tick. Drum 3: triangle sub pulse, LFO-swept low-pass. Snare: dry noise rim. Hat: dry ticks.",
  "key": "F# (kick 46 Hz, sub pulse F#1, tick figure in F# minor pentatonic)",
  "bpm": 128,
  "demonstrates": "Nothing in the groove is complicated; the movement comes from track lengths that do not line up (16 / 12 / 10) and from a slow LFO that opens and closes the sub-pulse filter, so each repeat of the one-bar kick sounds like a different bar.",
  "patterns": [
   "A: kick 16, hat 12 (three against four), sub pulse with LFO",
   "B: adds a 10-step tuned tick figure; hats get pitch and decay accents"
  ],
  "swing": "50%",
  "length": "16 (tracks of 10, 12)",
  "order": 101
 }
