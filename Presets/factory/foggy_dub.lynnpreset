 "meta": {
  "category": "Techno",
  "level": 1,
  "character": "deep, hazy, spacious",
  "technique": "FX delay as an instrument: voices routed to the FX bus, delay feedback and time locked per step",
  "secondary": [
   "tuned dyad stabs (per-step note)",
   "swing 54 %",
   "ghosted hats by velocity"
  ],
  "voices": "Kick: soft and deep. Drum 2 + Drum 3: square-wave stabs a minor third apart, FX bus. Snare: tuned rim, FX bus. Cymbal: filtered noise wash. Hat: soft.",
  "key": "F (stabs Fm third, kick E1)",
  "bpm": 122,
  "demonstrates": "One rim hit carries two FX locks (feedback and delay time): the echoes swell and bend after it, a dub-mixer throw played by the sequencer. The delay time is in milliseconds, set to a dotted eighth at 122 bpm.",
  "patterns": [
   "A: one dyad stab and one rim into the delay",
   "B: the dyad moves, the rim throws the delay"
  ],
  "swing": "54%",
  "length": "16",
  "order": 102
 }
