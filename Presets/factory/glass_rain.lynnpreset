 "meta": {
  "category": "Experimental",
  "level": 1,
  "character": "shimmering, spacious, hypnotic",
  "technique": "three tuned FM bells of different pattern lengths (12 / 16 / 19 steps) through a ping-pong delay: slow phasing makes an endless pentatonic cascade",
  "secondary": [
   "FM amount and decay locked per bell hit",
   "probability on the raindrops",
   "swelling noise breath and shimmer from the snare and cymbal voices"
  ],
  "voices": "Drum 1/2/3: FM bells in C3, C4, C5 (all through the FX delay). Snare: swelling noise breath. Cymbal: slow shimmer. Hat: raindrop ticks (dry).",
  "key": "C major pentatonic (C D E G A)",
  "bpm": 96,
  "demonstrates": "Each bell is the same simple voice; the music is in the track lengths (12, 16, 19 steps plus 24, 47 and 23 for breath, shimmer and drops) which drift against each other, and in the FM amount that is locked on some hits to make them glassier or woodier. Delay time is in ms (469 ms = three eighths at 96 bpm).",
  "patterns": [
   "A: sparse cascade",
   "B: the same notes, bell timbres and decays locked on selected hits"
  ],
  "swing": "50%",
  "length": "16 (tracks of 12, 19, 23, 24, 47)",
  "order": 118
 }
}
