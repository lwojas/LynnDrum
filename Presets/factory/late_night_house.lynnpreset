 "meta": {
  "category": "House",
  "level": 1,
  "character": "deep, soft, swung, warm",
  "technique": "groove: 57 % swing, shaker accents by velocity (and velocity-driven brightness), ghosted clap",
  "secondary": [
   "sub bass playing chord roots by per-step note",
   "low conga by tuned tom voice added in B",
   "rimshot from the cymbal voice"
  ],
  "voices": "Kick: soft, round. Drum 2: low conga. Drum 3: sine sub. Snare: soft clap (noise + sample). Cymbal: tuned rimshot. Hat: noise shaker.",
  "key": "A minor (kick E1 41 Hz, sub bass A1 / C2 / G1 above it, congas around E3)",
  "bpm": 122,
  "demonstrates": "The feel comes from the instrument, not from the notes: the shuffle swings every odd 16th, shaker velocities alternate soft/hard, and the velocity of a hit also shifts the shaker's high-pass, so accents are brighter as well as louder.",
  "patterns": [
   "A: two-bar groove",
   "B: congas added, bass filter and shaker decay accents locked"
  ],
  "swing": "57%",
  "length": "16 (tracks of 32)",
  "order": 106
 }
}
