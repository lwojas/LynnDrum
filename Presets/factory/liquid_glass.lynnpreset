 "meta": {
  "category": "Drum & Bass",
  "level": 1,
  "character": "soft, airy, flowing",
  "technique": "tuned FM bells through a delay over a shuffled two-step: the percussion carries the harmony",
  "secondary": [
   "56 % swing",
   "bell FM amount locked on the higher notes (brighter as they climb)",
   "round snare from the sine + soft noise"
  ],
  "voices": "Kick: soft. Drum 2: FM glass bell (FX delay). Drum 3: sine bass pluck. Snare: round pop. Cymbal: noise shaker. Hat: crisp shuffle.",
  "key": "C (bells: C - G - C - F - A# - D; pluck F#1/C#2)",
  "bpm": 172,
  "demonstrates": "Percussion that plays a line: six bell hits with different per-step notes and two FM locks give a rising melody; the delay (time set in ms to a dotted eighth at 172 bpm) turns each hit into a short phrase.",
  "patterns": [
   "A: soft two-step, shuffled hats, bass pluck",
   "B: the bell line climbs, FM amount locked on the top notes"
  ],
  "swing": "56%",
  "length": "16 (tracks of 32)",
  "order": 114
 }
