 "meta": {
  "category": "Technique",
  "level": 3,
  "character": "four on the floor, sixteen different kicks",
  "technique": "per-step locks on one drum voice: the rhythm is identical, the timbre is not",
  "secondary": [
   "phrase-ending pitch/decay lock",
   "drive, click, FM, waveform and pitch-envelope locks",
   "a falling scale by note and decay"
  ],
  "voices": "Kick: sine with pitch envelope and drive. Clap, hat: plain (the beat that stays the same).",
  "key": "G (kick 49 Hz)",
  "bpm": 126,
  "demonstrates": "Four bars of four-on-the-floor in which no kick is like its neighbour: bar 1 ends higher and shorter; bar 2 is snappy, crunchy, clicky and a boom; bar 3 is metallic, square, a laser zap and a tick; bar 4 falls. Every hit has at most two locks and a note. A is the same kick sixteen times.",
  "patterns": [
   "A: sixteen identical kicks",
   "B: four bars, sixteen different kicks, the same rhythm"
  ],
  "swing": "50%",
  "length": "16 (tracks of 64)",
  "order": 124
 }
}
