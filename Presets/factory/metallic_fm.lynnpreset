 "meta": {
  "category": "Technique",
  "level": 3,
  "character": "soft tone to bell to clang, on the same rhythm",
  "technique": "FM amount and FM ratio (FM freq) as timbre dials, locked per hit",
  "secondary": [
   "modulator ratio sweep at constant depth",
   "FM through the pitch envelope: depth falls as the hit decays",
   "second FM voice an octave and more below"
  ],
  "voices": "Kick: plain. Drum 2: sine FM'd by a sine (FM amount 0 in the kit). Drum 3: the same, lower.",
  "key": "E (drum 2 E4, drum 3 A3; D keeps the octave under)",
  "bpm": 110,
  "demonstrates": "FM Amount is the timbre dial: in B it rises across sixteen hits from 0 to 127, so one tom changes from a soft sine tone to a wooden knock to a metallic clang without changing pitch or rhythm. C holds the depth and sweeps the modulator ratio instead, which moves the inharmonic partials.",
  "patterns": [
   "A: FM 0: a soft sine tom",
   "B: FM amount ramps 0 -> 127 over 16 hits",
   "C: FM amount fixed, ratio sweeps",
   "D: B plus a second FM voice, lower, bright"
  ],
  "swing": "50%",
  "length": "16 (tracks of 32)",
  "order": 127
 }
}
