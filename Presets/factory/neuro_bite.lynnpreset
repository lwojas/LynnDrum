 "meta": {
  "category": "Drum & Bass",
  "level": 2,
  "character": "aggressive, animated, synthetic",
  "technique": "fast modulation: a sample-and-hold LFO on FM depth and a tempo-synced LFO on a resonant filter turn drum voices into growling bass",
  "secondary": [
   "FM ratio and LFO rate locked per note",
   "resonance lock on the second growl",
   "driven snare"
  ],
  "voices": "Kick: tight, driven. Drum 2: FM growl, resonant low-pass swept in sync. Drum 3: saw-FM bite, random LFO on FM depth. Snare: heavily driven. Cymbal: crash. Hat: driven.",
  "key": "F (growls F1 and D2, notes up to +10)",
  "bpm": 174,
  "demonstrates": "A hit of the bite voice is not one sound: its FM depth is being shaken by a random LFO the moment it triggers, and the locks move the modulator ratio (FM Freq) and the LFO rate per note, so one voice produces a line of different growls. (The LFO owns FM Amount, so that one can not be locked.)",
  "patterns": [
   "A: groove with a simple bite line",
   "B: the same line with FM ratio and LFO rate locked per note, a second growl voice"
  ],
  "swing": "50%",
  "length": "16 (tracks of 32)",
  "order": 115
 }
}
