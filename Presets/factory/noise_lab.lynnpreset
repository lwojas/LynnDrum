 "meta": {
  "category": "Technique",
  "level": 3,
  "character": "a groove made only of noise",
  "technique": "noise synthesis: kick, tom, hat, clap, wash and tick are all the noise oscillator, shaped by filters, envelopes, drive and the repeat counter",
  "secondary": [
   "noise colour by note (sample-and-hold rate)",
   "clap flutter by Repeat Count locks",
   "noise as a kick (low rate + low-pass + drive)"
  ],
  "voices": "Drum 1: noise thump. Drum 2: open noise perc. Drum 3: noise tick. Snare: noise clap. Cymbal: noise wash (slow attack). Hat: all-noise hat.",
  "key": "no key",
  "bpm": 118,
  "demonstrates": "A complete groove from one source: the noise oscillator is sample-and-hold at the voice pitch, so a low note is crunchy rumble and a high note is hiss. In B the noise perc walks the note from -24 to +36: the colour of the noise moves from rumble to hiss. In C the snare's repeat counter turns a hit into a flutter.",
  "patterns": [
   "A: the noise groove",
   "B: noise colour by note (perc walks -24 .. +36)",
   "C: clap flutter: repeat count 0, 2, 4, 6"
  ],
  "swing": "52%",
  "length": "16 (tracks of 32)",
  "order": 131
 }
}
