 "meta": {
  "category": "Technique",
  "level": 3,
  "character": "grooves that are not 16 steps",
  "technique": "per-track pattern lengths: 12 against 16, 20 against 16, a 14-step bar (7/8), and a stack of 10 / 12 / 14 against 16",
  "secondary": [
   "polymeter: each track loops at its own length",
   "patterns switch only when the longest track wraps",
   "tuned perc figures by note"
  ],
  "voices": "Kick, clap, hat: plain. Drum 2: tuned tom. Drum 3: low-passed bass blip.",
  "key": "D (bass voice D1 / F / G)",
  "bpm": 118,
  "demonstrates": "Track lengths are independent: A puts a 12-step hat figure over the 16-step kick (three against four, a full cycle in three bars), B a 20-step tom figure (five against four), C is a single 14-step bar (7/8, grouped 4 + 4 + 6), D stacks 10, 12 and 14 against 16 so the combined loop is far longer than any one track.",
  "patterns": [
   "A: 12 against 16 (3:4)",
   "B: 20 against 16 (5:4)",
   "C: a bar of 14 steps (7/8)",
   "D: 10 / 12 / 14 against 16"
  ],
  "swing": "50%",
  "length": "16 (tracks of 10, 12, 14, 20)",
  "order": 132
 }
