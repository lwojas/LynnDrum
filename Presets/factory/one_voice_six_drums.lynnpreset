 "meta": {
  "category": "Technique",
  "level": 3,
  "character": "a whole kit from one voice",
  "technique": "parameter locks + step note turn Drum 3 into a kick, snare, hat, tom, bell and bass",
  "secondary": [
   "waveform lock (sine -> noise)",
   "decay locks from 3 to 30",
   "FM amount lock for the bell, pitch-mod lock for the bass"
  ],
  "voices": "Only Drum 3 plays (every other voice is silent). Kit: sine with pitch envelope, drive, light high-pass.",
  "key": "no tuned key; the note offsets are per drum (kick -17, hat +24, bell +24, bass -12)",
  "bpm": 100,
  "demonstrates": "Each step carries at most two locks and a note: a note offset and a decay lock make kick, tom and bass; a waveform lock to noise makes snare and hat; an FM lock makes the bell. A is the voice unlocked: all eight hits identical.",
  "patterns": [
   "A: the voice unlocked (eight identical hits)",
   "B: the same eight hits as kick, hat, snare, hat, kick, tom, snare, bell",
   "C: two bars, six different drums"
  ],
  "swing": "50%",
  "length": "16 (tracks of 32)",
  "order": 123
 }
