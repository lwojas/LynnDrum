 "meta": {
  "category": "House",
  "level": 2,
  "character": "dirty, lo-fi, loose",
  "technique": "sample-rate reduction on every voice, locked per step to crush single hits; late snares by shift",
  "secondary": [
   "58 % swing",
   "ghost kick by velocity + shift",
   "dirty noise clap from the cymbal voice"
  ],
  "voices": "Kick: triangle, driven, crushed, kick click. Drum 2: crushed tuned perc. Drum 3: low-passed bass blip. Snare: driven noise + sample. Cymbal: dirty clap. Hat: crushed.",
  "key": "G (kick 49 Hz, bass blip A1 and D2)",
  "bpm": 124,
  "demonstrates": "Sample-rate reduction is a per-voice dial and it can be locked per hit: in B two hats and the snare are crushed much harder than their neighbours for a dusty sampler feel, while the snares sit a few milliseconds late for a lazy backbeat.",
  "patterns": [
   "A: raw groove, lazy snare",
   "B: extra kick, flam clap, per-hit crush locks"
  ],
  "swing": "58%",
  "length": "16",
  "order": 107
 }
