 "meta": {
  "category": "Drum & Bass",
  "level": 2,
  "character": "fluid, relentless, light",
  "technique": "a rolling hat made entirely of velocity: every 16th plays, the accent pattern and the velocity-driven filter make the groove",
  "secondary": [
   "ghost snare voice (Drum 3) at low velocity",
   "shaker from the cymbal voice",
   "hat accent cycle changes between patterns 1 and 2"
  ],
  "voices": "Kick: tight. Drum 2: rim tick. Drum 3: soft ghost snare. Snare: tight crack. Cymbal: noise shaker. Hat: driven metallic, velocity opens the high-pass.",
  "key": "kick 46 Hz (F#1), rim tick pitched around A5-C#6",
  "bpm": 174,
  "demonstrates": "There is no rhythmic variation in the hats at all (every 16th); the pattern is in the velocities. Velocity changes the loudness and also, through the velocity target on the filter, how bright each hat is, so accents are heard as both.",
  "patterns": [
   "A: hats on every 16th with a 4-step velocity cycle, ghosts, shaker",
   "B: accents every third 16th (a cycle of three over the bar of sixteen) plus a tuned rim figure"
  ],
  "swing": "54%",
  "length": "16 (tracks of 32)",
  "order": 112
 }
}
