 "meta": {
  "category": "Techno",
  "level": 2,
  "character": "mechanical, abrasive, dense",
  "technique": "industrial sound design: FM, hard drive, sample-rate crush, a fast LFO shaking FM depth",
  "secondary": [
   "anvil riff by note + FM locks",
   "snare flam roll with shift",
   "three-step machine rhythm against four-on-the-floor"
  ],
  "voices": "Kick: FM + drive + crush. Drum 2: FM anvil, ringing band-pass. Drum 3: saw motor, LFO on FM depth. Snare: clipped clang. Cymbal: steam burst. Hat: crushed ticks.",
  "key": "no tuned key; kick 44 Hz, anvil riff climbs from C5",
  "bpm": 138,
  "demonstrates": "Every sound has an edge from a different mechanism (FM, clipping, sample-rate reduction, a fast square LFO on FM depth); in pattern B two bars climb to a fill where the anvil's FM depth and the snare's filter are locked per hit.",
  "patterns": [
   "A: four on the floor, a machine rhythm of three against four, clang on 2 and 4",
   "B: two bars: the second climbs into a drop-out fill (flam roll, anvil riff, steam)"
  ],
  "swing": "50%",
  "length": "16 (tracks of 32)",
  "order": 103
 }
}
