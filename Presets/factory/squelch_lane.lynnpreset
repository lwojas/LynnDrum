 "meta": {
  "category": "House",
  "level": 2,
  "character": "squelchy, rolling, club",
  "technique": "a drum voice as an acid line: note + filter-cutoff lock + long/short decay lock per step, accents adding filter drive via velocity",
  "secondary": [
   "velocity target on filter drive (accent = louder and dirtier)",
   "resonant band-pass zap on Drum 2"
  ],
  "voices": "Kick: punchy. Drum 2: resonant band-pass zap. Drum 3: saw, resonant low-pass (the acid voice). Snare: noise clap. Cymbal: ride. Hat: bright.",
  "key": "C (acid voice C2; riff C, C+12, Eb, G ...)",
  "bpm": 124,
  "demonstrates": "There is no filter envelope in this engine, so the acid movement is played: per-step cutoff locks (two locks and a note per step) in pattern 2, and a velocity target on filter drive, so accented steps get louder and dirtier. (A velocity or LFO target can not share a parameter with a lock: the engine rewrites it every control tick, which is why accent does not target the cutoff.)",
  "patterns": [
   "A: riff with velocity accents adding filter drive",
   "B: cutoff and decay locked step by step, long accent notes"
  ],
  "swing": "52%",
  "length": "16",
  "order": 110
 }
}
