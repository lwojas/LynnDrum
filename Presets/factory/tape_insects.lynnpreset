 "meta": {
  "category": "Experimental",
  "level": 1,
  "character": "chirping, crunchy, alive",
  "technique": "random LFOs and sample-rate crush on tiny sounds with probabilities: every pass sounds different",
  "secondary": [
   "sample-and-hold LFO re-pitches each chirp and re-tunes each tick",
   "LFO rate and crush locked per buzz",
   "polymeter 32 / 24 / 27 / 16"
  ],
  "voices": "Drum 1: chirp (random pitch). Drum 2: band-pass tick (random band). Drum 3: crushed saw buzz, LFO on fine pitch. Snare: static snap. Cymbal: noise puff. Hat: cricket.",
  "key": "none (random pitches around F#6)",
  "bpm": 140,
  "demonstrates": "Sample-and-hold LFOs are modulation sources that never repeat: each chirp lands on a new pitch, each tick on a new band, while probabilities decide which of them play. In B, the buzz voice has its LFO rate and sample-rate reduction locked per hit, from a slow rattle to a high whine.",
  "patterns": [
   "A: the swarm",
   "B: buzz LFO rate and crush locked, chirp pitch sweep locked"
  ],
  "swing": "52%",
  "length": "16 (tracks of 24, 25, 31, 32)",
  "order": 120
 }
}
