 "meta": {
  "category": "Technique",
  "level": 3,
  "character": "dynamics that change the sound, not only the level",
  "technique": "velocity > volume plus velocity targets: filter on the snare, pitch depth on the kick, decay on the hat",
  "secondary": [
   "ghost notes that are darker and shorter, accents that are brighter and longer",
   "a crescendo roll whose last hits are the brightest"
  ],
  "voices": "Kick: velocity -> pitch mod. Snare: noise through a low-pass, velocity -> cutoff. Hat: velocity -> closed decay. Everything also gets louder with velocity.",
  "key": "no key",
  "bpm": 128,
  "demonstrates": "Without Velocity > Volume a step's velocity does nothing at all; with it, velocity is loudness, and a velocity target adds a second dimension. Here a soft snare is dark and a hard one is bright and snappy, a soft hat is short and a hard hat rings, a soft kick has less beater. A has only full velocities, B has accents and ghosts, C ends in a crescendo roll.",
  "patterns": [
   "A: full velocity everywhere (flat)",
   "B: accents and ghost notes: both louder and brighter",
   "C: crescendo snare roll: darker to brighter as it rises"
  ],
  "swing": "50%, 54%",
  "length": "16 (tracks of 32)",
  "order": 130
 }
}
