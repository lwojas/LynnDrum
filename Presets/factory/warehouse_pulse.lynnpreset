  "category": "Techno",
  "level": 2,
  "character": "dark, hard, short, controlled",
  "technique": "phrase-ending locks on kick/snare, stepped filter lock on a tuned bass voice",
  "secondary": [
   "velocity accents (Velocity > Volume on every voice)",
   "two-bar phrase",
   "tuned percussion in the kick's key"
  ],
  "voices": "Kick: short, distorted, tick click. Drum 2: metallic FM ting. Drum 3: tuned saw bass stab. Snare: noise + dark body. Cymbal: tight ride. Hat: bright, controlled.",
  "key": "G (kick 49 Hz, bass voice root G1)",
  "bpm": 132,
  "demonstrates": "Pattern B is rhythmically the same as A; only per-step locks differ: the last kick of the phrase gets a higher pitch and shorter decay, the snare accents get brighter and snappier, and the bass voice climbs a minor-third line while its filter opens.",
  "patterns": [
   "A: core groove, plain",
   "B: same groove + phrase-ending locks, pitched/filtered bass line"
  ],
  "swing": "51%",
  "length": "16 (tracks of 32)",
